option(DPDFCOMP_STATIC "Embed third-party libraries (and system runtimes where supported)" OFF)
if(NOT DPDFCOMP_FIND_INSTALLED)
  include(FetchContent)
endif()
find_package(PkgConfig REQUIRED)

if(DPDFCOMP_STATIC)
  set(BUILD_SHARED_LIBS OFF)
  if(NOT DPDFCOMP_FIND_INSTALLED)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
  endif()
  if(UNIX)
    set(CMAKE_FIND_LIBRARY_SUFFIXES .a)
    set(CMAKE_FIND_FRAMEWORK NEVER)
  endif()
  if(NOT DPDFCOMP_FIND_INSTALLED AND (CMAKE_SYSTEM_NAME STREQUAL "Linux" OR MINGW))
    add_link_options(-static)
  endif()
endif()

find_package(qpdf CONFIG REQUIRED)
if(qpdf_VERSION VERSION_LESS 11)
  message(FATAL_ERROR "dpdfcomp requires QPDF 11 or later")
endif()
find_package(ZLIB REQUIRED)
# AFDKO uses libxml2 types in headers, but none of its XML functions.
if(NOT DPDFCOMP_FIND_INSTALLED)
  find_path(LIBXML2_INCLUDE_DIR libxml/parser.h PATH_SUFFIXES libxml2 REQUIRED)
endif()
pkg_check_modules(LEPT REQUIRED IMPORTED_TARGET lept)
set(DPDFCOMP_QPDF qpdf::libqpdf)
if(DPDFCOMP_STATIC AND TARGET qpdf::libqpdf_static)
  set(DPDFCOMP_QPDF qpdf::libqpdf_static)
endif()
set(DPDFCOMP_LEPT PkgConfig::LEPT)

if(DPDFCOMP_STATIC AND UNIX)
  # pkg-config --static supplies private dependencies. Resolve each application
  # library to an archive, failing clearly rather than silently linking a dylib.
  function(static_package target)
    pkg_check_modules(PC_${target} REQUIRED ${ARGN})
    add_library(${target} INTERFACE)
    target_include_directories(${target} INTERFACE ${PC_${target}_INCLUDE_DIRS})
    target_link_options(${target} INTERFACE ${PC_${target}_STATIC_LDFLAGS_OTHER})
    foreach(name IN LISTS PC_${target}_STATIC_LIBRARIES)
      if(name MATCHES "^(m|dl|pthread|rt)$")
        target_link_libraries(${target} INTERFACE ${name})
      else()
        unset(archive)
        find_library(archive NAMES ${name} HINTS ${PC_${target}_STATIC_LIBRARY_DIRS}
          REQUIRED NO_CACHE)
        target_link_libraries(${target} INTERFACE ${archive})
      endif()
    endforeach()
  endfunction()
  static_package(dpdfcomp_qpdf libqpdf)
  # Some QPDF packages omit their crypto provider from libqpdf.pc.
  get_target_property(qpdf_links ${DPDFCOMP_QPDF} INTERFACE_LINK_LIBRARIES)
  if(qpdf_links MATCHES "[Cc]rypto")
    set(OPENSSL_USE_STATIC_LIBS TRUE)
    find_package(OpenSSL REQUIRED COMPONENTS Crypto)
    target_link_libraries(dpdfcomp_qpdf INTERFACE OpenSSL::Crypto)
  endif()
  static_package(dpdfcomp_tiff libtiff-4)
  find_library(TIFFXX_STATIC NAMES tiffxx REQUIRED)
  set(lept_packages lept libtiff-4)
  if("webp" IN_LIST LEPT_STATIC_LIBRARIES)
    list(APPEND lept_packages libwebp libwebpmux)
  endif()
  static_package(dpdfcomp_lept ${lept_packages})
  set(DPDFCOMP_QPDF dpdfcomp_qpdf)
  set(DPDFCOMP_TIFF ${TIFFXX_STATIC} dpdfcomp_tiff)
  set(DPDFCOMP_LEPT dpdfcomp_lept)
else()
  find_package(Tiff CONFIG QUIET)
  if(TARGET TIFF::tiff AND TARGET TIFF::tiffxx)
    set(DPDFCOMP_TIFF TIFF::tiffxx TIFF::tiff)
  else()
    find_package(TIFF REQUIRED COMPONENTS CXX)
    set(DPDFCOMP_TIFF TIFF::CXX TIFF::TIFF)
  endif()
  if(DPDFCOMP_STATIC)
    # On Windows use static dependency packages, e.g. vcpkg's x64-windows-static.
    get_target_property(qpdf_type ${DPDFCOMP_QPDF} TYPE)
    if(NOT qpdf_type STREQUAL "STATIC_LIBRARY")
      message(FATAL_ERROR "Static builds require a static QPDF dependency package")
    endif()
  endif()
endif()

if(DPDFCOMP_STATIC AND NOT DPDFCOMP_FIND_INSTALLED)
  # A minimal FreeType avoids optional font/image codecs and platform extensions.
  foreach(feature BZIP2 PNG HARFBUZZ BROTLI HVF)
    set(FT_DISABLE_${feature} ON CACHE BOOL "" FORCE)
  endforeach()
  set(FT_REQUIRE_ZLIB ON CACHE BOOL "" FORCE)
  FetchContent_Declare(freetype
    URL https://codeload.github.com/freetype/freetype/tar.gz/refs/tags/VER-2-15-0
    URL_HASH SHA256=87c7f1f8699b91e89f773f7dcfa505b044e1dae67f62a55d4e29c3afdcac4fb8)
  FetchContent_MakeAvailable(freetype)
  set(DPDFCOMP_FREETYPE freetype)
else()
  find_package(Freetype REQUIRED)
  set(DPDFCOMP_FREETYPE Freetype::Freetype)
  if(DPDFCOMP_FIND_INSTALLED)
    find_package(TBB CONFIG REQUIRED)
  else()
    find_package(TBB CONFIG QUIET)
  endif()
endif()
if(NOT TARGET TBB::tbb)
  set(TBB_TEST OFF CACHE BOOL "" FORCE)
  if(MINGW)
    # Some upstream Unix hardening flags are ignored by Clang's Windows target.
    set(TBB_STRICT OFF CACHE BOOL "" FORCE)
  endif()
  set(TBBMALLOC_BUILD OFF CACHE BOOL "" FORCE)
  set(TBB_DISABLE_HWLOC_AUTOMATIC_SEARCH ON CACHE BOOL "" FORCE)
  FetchContent_Declare(oneTBB
    URL https://codeload.github.com/uxlfoundation/oneTBB/tar.gz/refs/tags/v2023.1.0
    URL_HASH SHA256=191288b52e1e6b17198000b64d77d194bb65e791be46ebc606e9b091781e2070)
  FetchContent_MakeAvailable(oneTBB)
endif()

# Explicit image codecs; pkg-config provides static private dependencies on Unix.
if(DPDFCOMP_STATIC AND UNIX)
  static_package(dpdfcomp_turbojpeg libturbojpeg)
  static_package(dpdfcomp_openjpeg libopenjp2)
  set(DPDFCOMP_TURBOJPEG dpdfcomp_turbojpeg)
  set(DPDFCOMP_OPENJPEG dpdfcomp_openjpeg)
else()
  pkg_check_modules(TURBOJPEG REQUIRED IMPORTED_TARGET libturbojpeg)
  pkg_check_modules(OPENJPEG REQUIRED IMPORTED_TARGET libopenjp2)
  if(DPDFCOMP_STATIC AND WIN32)
    target_compile_definitions(PkgConfig::OPENJPEG INTERFACE OPJ_STATIC)
  endif()
  set(DPDFCOMP_TURBOJPEG PkgConfig::TURBOJPEG)
  set(DPDFCOMP_OPENJPEG PkgConfig::OPENJPEG)
endif()

set(DPDFCOMP_DEPENDENCIES ${DPDFCOMP_QPDF} ZLIB::ZLIB ${DPDFCOMP_TIFF}
  ${DPDFCOMP_FREETYPE} TBB::tbb ${DPDFCOMP_LEPT} ${DPDFCOMP_TURBOJPEG} ${DPDFCOMP_OPENJPEG})
if(WIN32)
  list(APPEND DPDFCOMP_DEPENDENCIES ws2_32)
elseif(UNIX)
  list(APPEND DPDFCOMP_DEPENDENCIES m)
endif()
